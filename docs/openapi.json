  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Selector": {
        "type": "object",
        "properties": {
          "bank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "bit_address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16383
          },
          "hex": {
            "type": "string",
            "minLength": 2,
            "maxLength": 62,
            "pattern": "^(?:[0-9A-Fa-f]{2})+$"
          }
        },
        "required": [
          "bank",
          "bit_address",
          "hex"
        ],
        "additionalProperties": false,
        "description": "Whole-byte mask, max 248 bits; bit_address + mask bits <= 16384. May match multiple tags."
      },
      "ReadRequest": {
        "type": "object",
        "properties": {
          "antenna": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "bank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "word_address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "selector": {
            "$ref": "#/components/schemas/Selector"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 8,
            "pattern": "^(?:[0-9A-Fa-f]{2})+$",
            "default": "00000000"
          },
          "words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        },
        "required": [
          "antenna",
          "bank",
          "word_address",
          "words",
          "selector"
        ],
        "additionalProperties": false
      },
      "WriteRequest": {
        "type": "object",
        "properties": {
          "antenna": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "bank": {
            "type": "integer",
            "enum": [
              1,
              3
            ]
          },
          "word_address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "selector": {
            "$ref": "#/components/schemas/Selector"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 8,
            "pattern": "^(?:[0-9A-Fa-f]{2})+$",
            "default": "00000000"
          },
          "hex": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128,
            "pattern": "^(?:[0-9A-Fa-f]{4})+$"
          }
        },
        "required": [
          "antenna",
          "bank",
          "word_address",
          "hex",
          "selector"
        ],
        "additionalProperties": false,
        "description": "1..32 words; EPC CRC word 0 forbidden; range cannot wrap. PC is not auto-adjusted. No automatic retries or readback."
      },
      "InventoryRequest": {
        "type": "object",
        "properties": {
          "antennas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "scan_time": {
            "type": "integer",
            "minimum": 3,
            "maximum": 20,
            "default": 3,
            "description": "100 ms units per antenna"
          },
          "q": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "default": 4
          },
          "session": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 0
          },
          "target": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "selector": {
            "$ref": "#/components/schemas/Selector"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "PowerRequest": {
        "type": "object",
        "properties": {
          "dbm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "persist": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "dbm"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "version": {
